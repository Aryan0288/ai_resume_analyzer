rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow users access to their own data tree
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      // Also allow guest / anonymous access during testing
      allow read, write: if request.auth == null || userId == 'anonymous' || userId == 'guest_user_123';
    }
  }
}
